# Dependencies — installed via package.json, not checked in
node_modules/

# Build output — electron-builder artifacts, regenerated by `npm run electron:build:*`
dist-electron/
dist-electron-vrsim/

# The desktop app's own built installers/auto-update feed payloads — large
# binaries that get rebuilt and redeployed by electron-builder, not source
downloads/

# Real user data — profile accounts (with real emails/avatars), leaderboards,
# published cakes. Never meant to leave this machine; a fresh deploy starts
# with these files absent, which server.js already handles (logs and starts
# empty rather than failing).
data/*.json
data/*.json.bak

# Self-signed dev TLS cert/key — regenerate locally, never share the key
certs/

# Editor/tool-local state, not project source
.vscode/
.claude/

# OS cruft
.DS_Store
Thumbs.db

# npm/node logs
npm-debug.log*
*.log
